md-snp() {
    unset PGHOST;
    unset PGPASSWORD;
    export PGHOST="media-distillery-pgsql-snp-global-v1-replica-1.cmz3dwjqe2te.us-east-1.rds.amazonaws.com"
    export PGPASSWORD="$(aws rds generate-db-auth-token --hostname=$PGHOST --port=5432 --username=media_distillery_global_human_read --region us-east-1)"
    echo $PGPASSWORD
}

