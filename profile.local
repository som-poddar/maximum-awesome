# all kubernetes related alias
# source: https://wiki.hbo.com/pages/viewpage.action?pageId=125074778#EKSClusterAccess-DailyUse:

# alias kubewest-prod="asdf shell kubectl 1.22.5 && kubectl --context=hurley-production-us-west-2 --namespace=production"
alias kubewest-snp="asdf shell kubectl 1.22.5 && kubectl --context=hurley-nonprod-us-west-2 --namespace=snp"
alias kubewest-stage="asdf shell kubectl 1.22.5 && kubectl --context=hurley-nonprod-us-west-2 --namespace=staging"
# alias kubeeast-prod="asdf shell kubectl 1.22.5 && kubectl --context=hurley-production-us-east-1 --namespace=production"
