refresh-submodules() {
  git submodule update --init --recursive
}

get-vault () {
     echo "getting Vault Token"
     unset VAULT_TOKEN;
     export VAULT_TOKEN=$(perform get-vault-token);
     # export VAULT_TOKEN=$(vault login -method=aws -field=token -address=https://vault.api.hbo.com role=default-role)
     echo $VAULT_TOKEN;
 }

